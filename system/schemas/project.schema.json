{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mneme Project",
  "description": "Projeto = unidade de contexto. project.md descreve objetivo/estado; .brain.yaml declara providers.",
  "type": "object",
  "required": ["id", "type", "name"],
  "properties": {
    "id": {"type": "string", "pattern": "^project-[a-z0-9-]+$"},
    "type": {"const": "project"},
    "name": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "paused", "done", "cancelled"]},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "relations": {"type": "array", "items": {"type": "object", "required": ["type", "target"]}},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "sensitivity": {"type": "string", "enum": ["public", "internal", "private", "confidential", "secret"]}
  },
  "additionalProperties": true
}
